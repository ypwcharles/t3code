 .../src/connection/supervisor.ts              | 15 ++-
 packages/ssh/src/tunnel.test.ts               | 91 ++++++++++++++++++-
 packages/ssh/src/tunnel.ts                    | 10 +-
 4 files changed, 159 insertions(+), 6 deletions(-)

