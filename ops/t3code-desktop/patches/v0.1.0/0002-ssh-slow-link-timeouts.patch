diff --git a/packages/ssh/src/tunnel.test.ts b/packages/ssh/src/tunnel.test.ts
index 9bb303d6..8a8d282d 100644
--- a/packages/ssh/src/tunnel.test.ts
+++ b/packages/ssh/src/tunnel.test.ts
@@ -441,6 +441,93 @@ describe("ssh tunnel scripts", () => {
     );
   });
 
+  it.effect.each([1_500, 6_000])(
+    "accepts %dms responses when creating and reusing a healthy tunnel without restarting it",
+    (latencyMs) =>
+      Effect.gen(function* () {
+        let probeStarted = yield* Deferred.make<void>();
+        let probes = 0;
+        let tunnels = 0;
+        let launches = 0;
+        let kills = 0;
+        const delayedClient = HttpClient.make((request) =>
+          Effect.gen(function* () {
+            probes += 1;
+            yield* Deferred.succeed(probeStarted, undefined);
+            yield* Effect.sleep(Duration.millis(latencyMs));
+            return HttpClientResponse.fromWeb(request, new Response("", { status: 200 }));
+          }),
+        );
+        const spawner = ChildProcessSpawner.make((command) =>
+          Effect.sync(() => {
+            const args = commandArgs(command);
+            if (args.includes("-N")) {
+              tunnels += 1;
+              return makeRunningProcess(() => {
+                kills += 1;
+              });
+            }
+            if (args.includes("--")) {
+              launches += 1;
+              return makeSuccessfulProcess('{"remotePort":3773}\n');
+            }
+            return makeSuccessfulProcess("\n");
+          }),
+        );
+        const layer = Layer.mergeAll(
+          NodeServices.layer,
+          Layer.succeed(ChildProcessSpawner.ChildProcessSpawner, spawner),
+          Layer.succeed(HttpClient.HttpClient, delayedClient),
+          Layer.succeed(NetService.NetService, testNetService),
+          SshAuth.SshPasswordPrompt.disabledLayer,
+          SshTunnel.SshEnvironmentManager.layer({ resolveCliRunner: Effect.succeed(ARCHIVE) }),
+        );
+        yield* Effect.gen(function* () {
+          const manager = yield* SshTunnel.SshEnvironmentManager;
+          const target = { alias: "devbox", hostname: "devbox", username: null, port: null };
+          const firstFiber = yield* Effect.forkChild(manager.ensureEnvironment(target));
+          yield* Deferred.await(probeStarted);
+          yield* TestClock.adjust(Duration.millis(20_000));
+          const first = yield* Fiber.join(firstFiber);
+          assert.equal(probes, 1);
+          probeStarted = yield* Deferred.make<void>();
+          const reuseFiber = yield* Effect.forkChild(manager.ensureEnvironment(target));
+          yield* Deferred.await(probeStarted);
+          yield* TestClock.adjust(Duration.millis(20_000));
+          const reused = yield* Fiber.join(reuseFiber);
+          assert.equal(reused.httpBaseUrl, first.httpBaseUrl);
+          assert.equal(probes, 2);
+          assert.equal(tunnels, 1);
+          assert.equal(launches, 1);
+          assert.equal(kills, 0);
+        }).pipe(Effect.provide(layer), Effect.scoped);
+      }).pipe(Effect.provide(TestClock.layer())),
+  );
+
+  it.effect("still bounds an unreachable tunneled endpoint at twenty seconds", () =>
+    Effect.gen(function* () {
+      const fiber = yield* Effect.forkChild(
+        Effect.result(
+          SshTunnel.waitForHttpReady({
+            baseUrl: "http://127.0.0.1:41773/",
+            timeoutMs: 20_000,
+            probeTimeoutMs: 8_000,
+          }),
+        ),
+      );
+      yield* Effect.yieldNow;
+      yield* TestClock.adjust(Duration.millis(20_000));
+      const result = yield* Fiber.join(fiber);
+      assert.isTrue(Result.isFailure(result));
+      if (Result.isFailure(result))
+        assert.include(result.failure.message, "Timed out waiting 20000ms");
+    }).pipe(
+      Effect.provide(
+        Layer.merge(TestClock.layer(), Layer.succeed(HttpClient.HttpClient, hangingHttpClient)),
+      ),
+    ),
+  );
